#!/usr/bin/env bash
# pre-push — Run lint, type-check, and tests for changed directories.
# Only checks what was modified. Fails fast within each directory group.
set -euo pipefail

# ⚠️ Strip inherited GIT_* env vars (see atlas/orchestrator/__tests__/state.test.ts).
# When this hook runs during a push from a linked worktree, git exports
# GIT_DIR=<git-dir>/worktrees/<branch> into the hook environment. If left
# set, every child git command — and the atlas test suite, whose
# throwaway-repo tests run `git init`/`git add`/`git commit` — operates on
# the PUSHING BRANCH'S repository instead of its intended target, silently
# corrupting the branch (observed 2026-08-06: the RES-91 branch gained stray
# "base" commits and its tree was replaced by a single file.txt while its
# pre-push hook ran the atlas suite).
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_CEILING_DIRECTORIES 2>/dev/null || true

REPO_ROOT="$(git rev-parse --show-toplevel)"

# If we are inside a git worktree, --show-toplevel points at the WORKTREE
# (e.g. atlas/state/worktrees/RES-85), which does NOT have node_modules
# installed. The main repo is the first entry of `git worktree list` and is
# where dependencies live. npm --prefix must target the MAIN repo, or every
# check here fails with missing binaries (agents push from worktrees).
if git rev-parse --git-common-dir >/dev/null 2>&1; then
  MAIN_REPO="$(git worktree list --porcelain 2>/dev/null | head -1 | sed 's/^worktree //')"
  if [ -n "$MAIN_REPO" ] && [ -d "$MAIN_REPO" ]; then
    REPO_ROOT="$MAIN_REPO"
  fi
fi

cd "$REPO_ROOT"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
CYAN='\033[0;36m'
NC='\033[0m'

FAILED=0

# ─── Detect changed directories ─────────────────────────────────────

# Get the range of commits being pushed.
# $1 = remote name, $2 = remote URL. stdin = <local-ref> <local-sha> <remote-ref> <remote-sha>
# We check what files changed relative to the remote.
CHANGED=""
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    # New branch — compare against the merge-base with the target branch
    # (usually main or master). Fall back to HEAD~20 if we can't determine.
    BASE=$(git merge-base "$local_ref" origin/main 2>/dev/null || git merge-base "$local_ref" origin/master 2>/dev/null || echo "HEAD~20")
    CHANGED="$CHANGED$(git diff --name-only "$BASE" "$local_sha" 2>/dev/null || true)"$'\n'
  else
    CHANGED="$CHANGED$(git diff --name-only "$remote_sha" "$local_sha" 2>/dev/null || true)"$'\n'
  fi
done

# If no stdin (e.g., manual run), check against HEAD~1
if [ -z "$CHANGED" ]; then
  CHANGED="$(git diff --name-only HEAD~1 2>/dev/null || git diff --name-only --cached 2>/dev/null || true)"
fi

RUN_BACKEND=false
RUN_FRONTEND=false
RUN_ATLAS=false

if echo "$CHANGED" | grep -q '^backend/'; then
  RUN_BACKEND=true
fi
if echo "$CHANGED" | grep -q '^frontend/'; then
  RUN_FRONTEND=true
fi
if echo "$CHANGED" | grep -q '^atlas/'; then
  RUN_ATLAS=true
fi

# If nothing matched (e.g., root-level config changes), run everything
if ! $RUN_BACKEND && ! $RUN_FRONTEND && ! $RUN_ATLAS; then
  RUN_BACKEND=true
  RUN_FRONTEND=true
  RUN_ATLAS=true
fi

# ─── Helpers ─────────────────────────────────────────────────────────

# Serialize the heavy test runs across CONCURRENT pushes (worker agents push
# from parallel worktrees). Running 5 full test:cov suites at once on one
# machine causes CPU/memory contention — tests randomly fail with timeouts
# or coverage dips below threshold, the push is rejected, and the ticket
# gets a spurious strategy-retry loop (observed: RES-85/RES-81 'strategy
# retry 3/2' with test:cov passing standalone). flock queues pushes so each
# one gets the machine to itself; 900s covers a full backend+frontend+atlas
# suite run.
LOCK_FILE="${TMPDIR:-/tmp}/atlas-pre-push.lock"
exec 9>"$LOCK_FILE"
# Wait for the lock as long as needed — a push must NEVER fail just because
# another push (a worker's) holds the lock. Previously flock -w 900 gave up
# after 15 min and the push failed SILENTLY, stranding local commits for
# hours (observed: 7+ commits waited 3h because concurrent worker pushes kept
# holding the lock). Retry forever; each 30s wait logs progress.
while ! flock -n 9; do
  echo "[pre-push] waiting for test lock (another push in progress)..."
  sleep 30
done

run_step() {
  local label="$1"
  shift
  printf "${CYAN}[pre-push]${NC} %s ... " "$label"
  if "$@" > /dev/null 2>&1; then
    printf "${GREEN}OK${NC}\n"
  else
    printf "${RED}FAILED${NC}\n"
    echo ""
    echo "── $label (full output) ──"
    "$@" 2>&1 || true
    echo ""
    FAILED=1
  fi
}

run_group() {
  local dir="$1"
  local label="$2"
  shift 2

  if ! eval "\$RUN_${dir}"; then
    echo ""
    echo "${CYAN}═══ ${label} ═══${NC} (skipped — no changes)"
    return
  fi

  echo ""
  echo "${CYAN}═══ ${label} ═══${NC}"

  for step in "$@"; do
    # step is "label§command" — e.g. "lint§npm --prefix $dir run lint"
    local step_label="${step%%§*}"
    local step_cmd="${step#*§}"
    run_step "$step_label" bash -c "$step_cmd"
    [ "$FAILED" -eq 1 ] && return
  done
  # Ensure the function always returns 0. The last [ ... ] check in the loop
  # returns 1 when FAILED=0, and with set -e that would kill the entire script.
  true
}

# ─── Backend ──────────────────────────────────────────────────────────

run_group "BACKEND" "Backend" \
  "lint§npm --prefix backend run lint" \
  "type-check§npm --prefix backend run type-check" \
  "test:cov§npm --prefix backend run test:cov"

# ─── Frontend ─────────────────────────────────────────────────────────

run_group "FRONTEND" "Frontend" \
  "lint§npm --prefix frontend run lint" \
  "type-check§npm --prefix frontend run type-check" \
  "test:cov§npm --prefix frontend run test:cov"

# ─── Atlas ────────────────────────────────────────────────────────────

run_group "ATLAS" "Atlas" \
  "lint§npm --prefix atlas run lint" \
  "test§npm --prefix atlas run test"

# ─── Result ───────────────────────────────────────────────────────────

echo ""
if [ "$FAILED" -eq 0 ]; then
  printf "${GREEN}[pre-push] All checks passed — pushing.${NC}\n"
  exit 0
else
  printf "${RED}[pre-push] Checks failed — push aborted.${NC}\n"
  exit 1
fi
