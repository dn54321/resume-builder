# ─── Production Environment (root .env.prod) — DROPLET ONLY ──────────────
# Generated by deploy/setup-droplet.sh from this template; never commit the
# real file (gitignored via `.env*`). To hand-roll one, copy this template
# to .env.prod and replace the placeholders.
#
# ⚠️ POSTGRES_PASSWORD + the two encryption keys MUST be preserved once the
# site has data — regenerating them makes stored data undecryptable and the
# database unreachable. deploy/setup-droplet.sh never overwrites an existing
# .env.prod.

# ─── Database (Postgres on the droplet; "db" is the compose service name)
POSTGRES_USER=resume
POSTGRES_PASSWORD=<RANDOM:32>
POSTGRES_DB=resume_builder
# Host "db" resolves inside the compose network.
DATABASE_URL=postgresql://resume:<POSTGRES_PASSWORD>@db:5432/resume_builder

# ─── Public URLs (single origin — no CORS; both = https://<your-domain>)
FRONTEND_URL=https://<your-domain>
VITE_API_BASE_URL=https://<your-domain>

# ─── App config ─────────────────────────────────────────────────────
NODE_ENV=production
MATCHING_ENGINE=keyword
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
BULLET_CAP=5

# ─── Security: encryption keys (64 hex chars each, openssl rand -hex 32)
# Each key is generated independently — NEVER reuse one key for both.
RESUME_FIELD_ENCRYPTION_KEY=<ENC:AES-256>
SESSION_ENCRYPTION_KEY=<ENC:AES-256>
