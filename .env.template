# ─── Root Environment (.env) — INFRASTRUCTURE ONLY ─────────────────
# This file holds INFRA-LEVEL configuration: ports, hosts, and the
# credentials for external infrastructure services (Linear, GitHub).
#
# App-specific configuration lives with the app:
#   backend/.env  → DATABASE_URL, MATCHING_ENGINE, encryption keys, PORT
#   frontend/.env → VITE_API_BASE_URL
#   .env.docker   → container env for `docker compose` (see .env.docker.template)
#
# HOW THIS IS LOADED:
#   - Docker Compose auto-reads this file for ${VAR} substitution in
#     docker-compose.yml (ports, URLs).
#   - ./setup.sh generates it from .env.template, preserving existing
#     values and filling <ENC:AES-256> / <RANDOM:32> placeholders.
#
# ⚠️ NEVER commit .env — gitignored. Only .env.template is tracked.

# ─── External API credentials (infrastructure services) ───────────
# Used by tooling/agents, not the resume app itself.

# Linear API key — the Atlas ticket system reads it to fetch/transition
# tickets. Get it: Linear → Settings → API keys → Create key.
LINEAR_API_KEY=

# GitHub personal access token (classic) — used by Atlas for PRs,
# webhooks, and merge-conflict scans. Scope: repo. Get it:
# GitHub → Settings → Developer settings → Personal access tokens.
GITHUB_API_KEY=

# ─── Hosts & ports (infrastructure) ────────────────────────────────
# These tell tools where the services live. The app containers read their
# own ports from .env.docker; these are the canonical defaults for
# anything outside Docker (local scripts, CI, Atlas).

# Runtime environment: development | production | test.
NODE_ENV=development

# Backend port the app listens on (default 3000). Keep in sync with
# BACKEND_PORT in .env.docker when running via Docker.
PORT=3000

# Frontend origin the backend allows via CORS.
FRONTEND_URL=http://localhost:5173

# Frontend API origin (baked into the Vite build). Must match where the
# backend is reachable from the browser.
VITE_API_BASE_URL=http://localhost:3000
