# ─── Docker Environment (.env.docker) ──────────────────────────────
# Infrastructure-level settings for `docker compose up` (resume-backend +
# resume-frontend containers). Everything here is HOST-side infra: ports,
# hosts, and the encryption keys the containers must share.
#
# HOW THIS IS LOADED:
#   docker-compose.yml uses `env_file: .env.docker` to inject these into
#   both services, and references ${VAR} for port/host substitution in the
#   compose file itself. Copy this template to .env.docker and fill values:
#     cp .env.docker.template .env.docker
#   (or run ./setup.sh — it generates .env.docker from this template and
#   preserves existing values on re-runs).
#
# ⚠️ NEVER commit .env.docker — it is gitignored. Only this template is
# tracked. Generator placeholders (<ENC:AES-256>) become real secrets on
# first setup; do not paste real keys into the template.

# ─── Ports (host-side mappings) ────────────────────────────────────
# These are the HOST ports the containers bind. Inside the containers the
# apps always listen on their fixed ports (backend 3000, frontend 5173);
# the mapping lets you run them on any host port without code changes.

# Host port for the backend (NestJS). Maps to container port 3000.
# Change to e.g. 3001 to avoid a conflict with another service.
BACKEND_PORT=3000

# Host port for the frontend (Vite dev server). Maps to container port 5173.
FRONTEND_PORT=5173

# ─── Backend app config ────────────────────────────────────────────
# These become the backend container's environment (NODE_ENV, PORT,
# DATABASE_URL, FRONTEND_URL, encryption keys). They mirror the keys in
# backend/.env — keep the two in sync.

# Runtime environment: development (watch/HMR), production, or test.
NODE_ENV=development

# SQLite connection string, resolved INSIDE the container. The backend
# container runs with cwd /app, so file:./prisma/db/dev.db resolves to
# /app/prisma/db/dev.db — which is bind-mounted from the host at
# backend/prisma/db/dev.db (the single canonical dev DB, see the
# docker-compose comment). This MUST stay file:./prisma/db/dev.db — the
# old file:./dev.db pointed at /app/dev.db (a separate, wrong file).
DATABASE_URL=file:./prisma/db/dev.db

# CORS origin the backend allows. ${FRONTEND_PORT} is substituted by
# docker compose from the FRONTEND_PORT value above.
FRONTEND_URL=http://localhost:${FRONTEND_PORT}

# ─── Security: encryption keys ─────────────────────────────────────
# Each key protects ONE class of data and is generated independently
# (openssl rand -hex 32). They MUST match backend/.env so data written by
# a local run can be read by the container and vice-versa — a mismatch
# causes "Unsupported state or unable to authenticate data" (observed
# 2026-08-06: host key vs container key differed and decryption failed).

# AES-256-GCM key (64 hex chars) for PII resume fields (SectionField
# values are encrypted at rest). Generate: openssl rand -hex 32
RESUME_FIELD_ENCRYPTION_KEY=<ENC:AES-256>

# AES-256-GCM key (64 hex chars) for session tokens. Currently reserved —
# the auth service uses it for signed session cookies. Same generation.
SESSION_ENCRYPTION_KEY=<ENC:AES-256>
