# ─── Frontend dev image (Vue 3 + Vite + pnpm) ───────────────────────────
FROM node:22-alpine

WORKDIR /app

# Install pnpm
RUN corepack enable && corepack prepare pnpm@latest --activate

# Copy package manifest and workspace config (needed for build approvals)
COPY frontend/package.json frontend/pnpm-workspace.yaml ./

# Install dependencies
RUN pnpm install

# Copy config files (source is mounted at runtime)
COPY frontend/index.html \
     frontend/vite.config.ts \
     frontend/tsconfig.json \
     frontend/tsconfig.app.json \
     frontend/tsconfig.node.json \
     frontend/tsconfig.vitest.json \
     frontend/env.d.ts \
     ./

EXPOSE 5173

CMD ["pnpm", "exec", "vite", "--host", "0.0.0.0"]
