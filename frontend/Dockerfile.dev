# ─── Frontend dev image (Vue 3 + Vite + pnpm) ───────────────────────────
FROM node:22-alpine

WORKDIR /app

# Install pnpm
RUN corepack enable && corepack prepare pnpm@10 --activate

ENV PNPM_IGNORED_BUILDS_EXIT_CODE=0

# Copy package manifest (pnpm generates lockfile if none exists)
COPY frontend/package.json ./

# Pre-approve core-js build before install (pnpm 11 requires explicit approval)
RUN pnpm approve-builds core-js || true

# Install dependencies
RUN pnpm install

# Copy config files (source is mounted at runtime)
COPY frontend/index.html \
     frontend/vite.config.ts \
     frontend/tsconfig.json \
     frontend/tsconfig.app.json \
     frontend/tsconfig.node.json \
     frontend/tsconfig.vitest.json \
     frontend/env.d.ts \
     ./

EXPOSE 5173

CMD ["pnpm", "exec", "vite", "--host", "0.0.0.0"]
