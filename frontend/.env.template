# ─── Frontend Environment (frontend/.env) — APP-SPECIFIC ──────────
# Configuration for the Vue/Vite frontend. Only Vite-prefixed vars are
# exposed to the app (VITE_* are baked into the build).
# Copy to frontend/.env (or run ./setup.sh); gitignored.

# Base URL of the backend API the browser talks to. Defaults to the
# host-mapped backend port (3000). Override for a deployed/remote backend.
VITE_API_BASE_URL=http://localhost:3000
