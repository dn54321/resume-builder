# ─── Backend dev image (NestJS + pnpm) ──────────────────────────────────
FROM node:22-alpine

WORKDIR /app

# Install pnpm
RUN corepack enable && corepack prepare pnpm@latest --activate

# Copy package files first (layer caching)
COPY backend/pnpm-workspace.yaml ./
COPY backend/package.json backend/pnpm-lock.yaml ./

# Install dependencies
RUN pnpm install --frozen-lockfile

# Copy Prisma schema and generate client (patched for CJS compatibility)
COPY backend/prisma ./prisma
COPY backend/scripts ./scripts
RUN pnpm run prisma:generate

# Copy remaining config files (source is mounted at runtime)
COPY backend/nest-cli.json backend/tsconfig.json backend/tsconfig.build.json ./

EXPOSE 3000

# ⚠️ Use `prisma migrate deploy` (additive, safe), NOT `prisma db push`.
# db push syncs the schema by dropping/recreating tables when columns
# change, wiping the persisted volume DB (observed 2026-08-06: adding the
# `visible`/`volunteer` columns reset the backend-db volume, losing user
# resumes). migrate deploy only applies the additive migrations in
# prisma/migrations/ — never drops tables, never wipes rows.
CMD pnpm run prisma:migrate && pnpm run start:dev
