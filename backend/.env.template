# ─── Backend Environment (backend/.env) — APP-SPECIFIC ────────────
# Configuration for the NestJS backend application itself (database,
# matching engine, encryption keys, runtime). Infrastructure (ports/hosts/
# API credentials) lives in the root .env; container env lives in
# .env.docker. Copy this template to backend/.env (or run ./setup.sh).
#
# ⚠️ NEVER commit backend/.env — gitignored. Only this template is
# tracked. <ENC:AES-256> placeholders become real 64-hex keys on first
# setup.

# Runtime environment: development | production | test.
NODE_ENV=development

# HTTP port the backend listens on (default 3000). Inside Docker the
# compose file pins PORT=3000 regardless — this applies to local runs.
PORT=3000

# SQLite connection string. file:./prisma/db/dev.db resolves relative to
# the backend cwd → backend/prisma/db/dev.db (the canonical dev DB, also
# bind-mounted into the Docker container — one file for local + container).
DATABASE_URL=file:./prisma/db/dev.db

# CORS origin the backend allows (the frontend's origin).
FRONTEND_URL=http://localhost:5173

# Tailor matching engine: keyword | llm | hybrid.
#   keyword — lexical skill/bullet matching (fast, no external calls)
#   llm     — an LLM ranks bullets by relevance (needs LLM_API_KEY)
#   hybrid  — keyword pre-filter (2× bulletCap) then LLM re-rank
MATCHING_ENGINE=keyword

# API key for the LLM matching engine (only needed when MATCHING_ENGINE
# is llm or hybrid).
LLM_API_KEY=

# Model id used by the LLM engine (default gpt-4o-mini).
LLM_MODEL=gpt-4o-mini

# Max bullets kept per entry after tailoring (1–20, default 5).
BULLET_CAP=5

# ─── Security: encryption keys ────────────────────────────────────
# AES-256-GCM keys (64 hex chars each). Each protects ONE data class and
# must be generated independently (openssl rand -hex 32). ⚠️ These MUST
# match .env.docker (the container's keys) — a mismatch makes saved data
# undecryptable ("Unsupported state or unable to authenticate data").

# Key for PII resume fields (SectionField values encrypted at rest).
RESUME_FIELD_ENCRYPTION_KEY=<ENC:AES-256>

# Key for session tokens / signed cookies.
SESSION_ENCRYPTION_KEY=<ENC:AES-256>
